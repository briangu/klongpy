(call (sym .l) (str "util.kg"))
(call (sym .module) (qsym help))
(def (sym opdb`help) (list (list (str " a:=b") (str "Amend") (str "a=vector, b=[x n0 ...]; amend x in a@n0, ...")) (list (str " a:=b") (str "Amend") (str "a=string, b=[s n0 ...]; amend string s at a@n0, ...")) (list (str " a:-b") (str "Amend-in-Depth") (str "a=vector, b=[x n0 ...]; amend x in (a@n0)@...")) (list (str " @a") (str "Atom") (str "1, if 'a' is atomic")) (list (str " :#a") (str "Char") (str "a=integer; character with code point 'a'")) (list (str " a:_b") (str "Cut") (str "a=integer|list, b=vector; cut 'b' at 'a' or at a0, ...")) (list (str " a::b") (str "Define") (str "a=symbol; assign the value of 'b' to 'a'")) (list (str " a%b") (str "Divide") (str "a,b=real; quotient of 'a' and 'b'")) (list (str " a_b") (str "Drop") (str "a=integer, b=vector; drop 'a' elements from 'b'; -b = drop from end")) (list (str " !a") (str "Enumerate") (str "a=integer; list of integers 0..'a'-1")) (list (str " a=b") (str "Equal") (str "a,b=real|char|string; 1, if 'a' equals 'b'")) (list (str " &a") (str "Expand/Where") (str "a=list; list of integers 0.. where each xi is included ai times")) (list (str " &a") (str "Expand/Where") (str "a=integer; list of 'a' zeroes")) (list (str " a?b") (str "Find") (str "a=vector; vector of indices of 'b' in 'a'")) (list (str " a?b") (str "Find") (str "a=string, b=char; vector of indices of 'b' in 'a'")) (list (str " a?b") (str "Find") (str "a=string, b=string; vector of indices of substring 'b' in 'a'")) (list (str " a?b") (str "Find") (str "a=dict; tuple with key 'b' or :undefined")) (list (str " *a") (str "First") (str "a=vector; first element or []")) (list (str " *a") (str "First") (str "a=string; first element or \"\"")) (list (str " _a") (str "Floor") (str "a=real; 'a' rounded to -infinity")) (list (str " a:$b") (str "Form") (str "b=string; convert 'b' to an object of the same form (type) as 'a'")) (list (str " $a") (str "Format") (str "convert 'a' to a string representing the value of 'a'")) (list (str " a$b") (str "Format2") (str "a=real|list; when both operands are lists, apply pairwise. Format 'b', pad with 'a' blanks (a<0 = pad on the left) or to align to x.y digits")) (list (str " >a") (str "Grade-Down") (str "a=vector; vector of indices of elements of 'a' in descending order")) (list (str " <a") (str "Grade-Up") (str "a=vector; vector of indices of elements of 'a' in ascending order")) (list (str " =a") (str "Group") (str "a=vector; index lists of equal elements of 'a', in order of first appearance")) (list (str " a@b") (str "Index/Apply") (str "a=vector, b=integer; extract b'th element of 'a' (b<0 = from the end)")) (list (str " a@b") (str "Index/Apply") (str "a=vector, b=list(integer); extract bi'th elements from 'a'")) (list (str " a:@b") (str "Index-in-Depth") (str "a=vector, b=integer; extract b'th element of 'a'")) (list (str " a:@b") (str "Index-in-Depth") (str "a=vector, b=list(integer); extract (a@b0)@...")) (list (str " a:%b") (str "Integer-Divide") (str "truncated quotient of 'a' and 'b'")) (list (str " a,b") (str "Join") (str "join 'a' and 'b' in a list/vector")) (list (str " a<b") (str "Less") (str "a,b=real|char|vector; 1, if 'a' is less than 'b'")) (list (str " ,a") (str "List") (str "single-element list containing 'a'")) (list (str " a~b") (str "Match") (str "1, if a=b or 'a' and 'b' are equal vectors")) (list (str " a|b") (str "Max/Or") (str "a,b=real; greater value of 'a' and 'b'; also logical OR")) (list (str " a&b") (str "Min/And") (str "a,b=real; lesser value of 'a' and 'b'; also logical AND")) (list (str " a-b") (str "Minus") (str "a,b=real; difference between 'a' and 'b'")) (list (str " a>b") (str "More") (str "a,b=real|char|vector; 1, if 'a' is greater than 'b'")) (list (str " -a") (str "Negate") (str "a=real; negative value")) (list (str " ~a") (str "Not") (str "logical complement")) (list (str " a+b") (str "Plus") (str "sum")) (list (str " a^b") (str "Power") (str "'a' raised to the b'th power")) (list (str " ?a") (str "Range") (str "a=vector; unique elements of 'a' in order of appearance")) (list (str " %a") (str "Reciprocal") (str "1 divided by 'a'")) (list (str " a:^b") (str "Reshape") (str "a=vector|integer; 'b' reshaped to the dimensions of 'a', row-major")) (list (str " a!b") (str "Remainder") (str "truncated division remainder of a:%b")) (list (str " |a") (str "Reverse") (str "a=vector; reversed vector")) (list (str " a:+b") (str "Rotate") (str "a=integer, b=vector; 'b' rotated to right by 'a' elements (a<0 = left)")) (list (str " ^a") (str "Shape") (str "a=vector; vector of dimensions of 'a'; 0 for atoms")) (list (str " #a") (str "Size") (str "magnitude of numbers, size of vectors, code points of characters")) (list (str " a:#b") (str "Split") (str "a=integer>0, b=vector; split 'b' into 'a'-element subvectors")) (list (str " a:#b") (str "Split") (str "a=list(integer), b=vector; split into subvectors of sizes in 'a'")) (list (str " a#b") (str "Take") (str "a=integer, b=vector; extract first (a<0 = last) 'a' elements from 'b'")) (list (str " a*b") (str "Times") (str "a,b=real; product")) (list (str " +a") (str "Transpose") (str "a=vector; transpose of 'a'; 'a' must be symmetric")) (list (str " :_a") (str "Undefined") (str "1, if 'a' is :undefined"))))
(cond (d "~" (list) (sym .helpdb)) (def (sym .helpdb) (sym opdb`help)) (num 0))
(def (sym pho`help) (fn 1 (call (sym .d) (d "_" (num 1) (d "$" (num 7) (m "*" (d "@" (sym .helpdb) (arg x)))))) (call (sym .d) (d "@" (d "@" (sym .helpdb) (arg x)) (num 2))) (call (sym .p) (str ""))))
(def (sym phf`help) (fn 1 (call (sym .p) (m "*" (d "@" (sym .helpdb) (arg x)))) (adv (verb (fn 1 (call (sym .p) (d "," (str "    ") (arg x))))) (adverbs "'") (d "_" (num 1) (d "@" (sym .helpdb) (arg x))))))
(def (sym ph`help) (fn 1 (cond (d "~" (char " ") (m "*" (m "*" (d "@" (sym .helpdb) (arg x))))) (call (sym pho`help) (arg x)) (call (sym phf`help) (arg x)))))
(def (sym fho`help) (fn 2 (d "|" (m "~" (d "~" (list) (d "?" (m "*" (arg x)) (arg y)))) (m "~" (d "~" (list) (d "?" (d "@" (arg x) (num 1)) (arg y)))))))
(def (sym fhf`help) (fn 2 (d "&" (m "~" (d "~" (str "") (arg y))) (m "~" (d "~" (list) (d "?" (m "*" (arg x)) (arg y)))))))
(def (sym fh`help) (fn 2 (cond (d "~" (char " ") (m "*" (m "*" (arg x)))) (call (sym fho`help) (arg x) (arg y)) (call (sym fhf`help) (arg x) (arg y)))))
(def (sym help`help) (fn 1 (locals h`help) (def (sym h`help) (arg x)) (adv (verb (sym ph`help)) (adverbs "'") (m "&" (adv (verb (fn 1 (call (sym fh`help) (arg x) (sym h`help)))) (adverbs "'") (sym .helpdb)))) (list)))
(def (sym helpadd`help) (fn 1 (cond (d "?" (sym .helpdb) (m "*" (arg x))) (num 1) (def (sym .helpdb) (d "," (sym .helpdb) (arg x))))))
(call (sym .module) (num 0))
