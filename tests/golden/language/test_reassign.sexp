(def (sym a) (num 10))
(call (sym t) (str "a=10") (sym a) (num 10))
(def (sym a) (num 12))
(call (sym t) (str "a=12") (sym a) (num 12))
(call (sym .pyf) (str "math") (str "pi"))
(def (sym a) (sym pi))
(call (sym t) (str "a=math.pi") (sym a) (sym pi))
(def (sym a) (fn 0 (sym pi)))
(call (sym t) (str "a()=math.pi") (call (sym a)) (sym pi))
(def (sym a) (fn 0 (d "*" (num 2) (sym pi))))
(call (sym t) (str "a()=math.pi") (call (sym a)) (d "*" (num 2) (sym pi)))
(def (sym fn) (fn 0 (def (sym a) (d "*" (num 2) (sym pi)))))
(call (sym fn))
(call (sym t) (str "fn();a=2*pi") (sym a) (d "*" (num 2) (sym pi)))
