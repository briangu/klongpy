.l("./expect.kg")
t::.table(:{;"symbol";["AA" "BB"];"lot";[7 7];"qty";[10 20]})
expect("column order follows construction";.schema(t);["symbol" "lot" "qty"])
alias::t
.insert(t;["CC" 8 30])
expect("an existing alias sees an append";alias@"qty";[10 20 30])
expect("create composite index";.index(t;["symbol" "lot"]);["symbol" "lot"])
.insert(alias;["BB" 7 99])
expect("upserting an existing key replaces its quantity";+/(t@"qty");139)
expect("upsert keeps the row count";#(t@"qty");3)
expect("remove active index";.rindex(t);1)
expect("removing it again reports no index";.rindex(t);0)
.insert(t;["BB" 7 1])
expect("unkeyed table appends a repeated key";#(alias@"qty");4)
expect("unkeyed table keeps both quantities";+/(t@"qty");140)
.p("PASS table_values")
