.l("./expect.kg")
.l("./arrays.kg")
expect("sum of squares";energy([2 3 4]);29)
expect("named function destructures its input";window([3 5]);[8 15])
scale(factor;values)::{factor*values}
double::scale(2)
expect("projection applied to a vector";double([1 2 3]);[2 4 6])
cfg:::{;"limit";12}
expect("required dictionary field";cfg.limit;12)
expect("optional dictionary field";:_cfg@"missing";1)
expect("missing required field";(.try({cfg.missing};[])@1)@"kind";"name")
expect("name errors can be caught";(.try({.err("name";"missing column")};[])@1)@"kind";"name")
.l("checks")
expect("shared assertion succeeds";checks.require(1;"range";"bad width");1)
failure::.try({checks.require(0;"range";"bad width")};[])
expect("shared assertion preserves diagnostics";[;failure@0;(failure@1)@"kind";(failure@1)@"message"];[0 "range" "bad width"])
.l("math")
expect("math loads in a fresh strict interpreter";gcd(12;18);6)
.p("PASS language")
