.l("./expect.kg")
expect("positive overflowing sum";.exactadd(9223372036854775807;1);9223372036854775808)
expect("negative overflowing sum";.exactadd(-9223372036854775808;-1);-9223372036854775809)
expect("addition cancels a promoted integer";.exactadd(9223372036854775808;-9223372036854775807);1)
expect("exact sum rejects a list";(.try({.exactadd(4;[1 2])};[])@1)@"kind";"type")
expect("positive overflowing product";.exactmul(3037000500;3037000500);9223372037000250000)
expect("negative overflowing product";.exactmul(-3037000500;3037000500);-9223372037000250000)
expect("positive difference beyond signed maximum";.exactsub(9223372036854775807;-1);9223372036854775808)
expect("negative difference beyond signed minimum";.exactsub(-9223372036854775808;1);-9223372036854775809)
expect("cancellation after promotion";.exactsub(.exactmul(3037000500;3037000500);9223372037000249999);1)
expect("promoted result returns to machine width";1+.exactsub(9223372036854775808;1);-9223372036854775808)
expect("ordinary product keeps machine-width semantics";3037000500*3037000500;-9223372036709301616)
expect("quotient above float precision";.exactdiv(27021597764222979;3);9007199254740993)
expect("arbitrary precision quotient";.exactdiv(10^80;10^40);10^40)
expect("minimum divided by minus one";.exactdiv(-9223372036854775808;-1);9223372036854775808)
expect("signed quotient";.exactdiv(42;-7);-6)
expect("zero quotient";.exactdiv(0;-7);0)
expect("nonintegral quotient";(.try({.exactdiv(-5;2)};[])@1)@"kind";"range")
expect("division by zero";(.try({.exactdiv(1;0)};[])@1)@"kind";"range")
expect("exact product rejects a list";(.try({.exactmul([1 2];3)};[])@1)@"kind";"type")
expect("exact difference rejects a float";(.try({.exactsub(3;1.0)};[])@1)@"kind";"type")
expect("exact quotient rejects a string";(.try({.exactdiv("42";2)};[])@1)@"kind";"type")
.p("PASS exact integers")
