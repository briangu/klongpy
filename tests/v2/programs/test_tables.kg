.l("./expect.kg")
.l("./tables.kg")
expect("column order";.schema(ledger);["account" "lot" "qty"])
expect("column access";ledger@"qty";[10 20])
expect("append a batch";appendrows();[[1 7 10] [2 7 20] [2 8 30] [3 7 40]])
.l("./tables.kg")
expect("composite keys replace or insert";upsertrows();[[1 7 10] [1 8 5] [2 7 99]])
.l("./tables.kg")
expect("removing a key restores append";unkey();2)
.l("./tables.kg")
.index(ledger;["account" "lot"])
.insert(ledger;[[2 7 88] [2 7 99]])
expect("last update in a batch wins";rows();[[1 7 10] [2 7 99]])
.p("PASS tables")
