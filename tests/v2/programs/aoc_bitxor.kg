.l("./expect.kg")
expect("integer xor";.bitxor(6;3);5)
expect("signed words";.bitxor(-1;6);-7)
wordBits::.ver()@"int";half::2^(wordBits-2);largest::half+(half-1)
expect("all machine bits";.bitxor((-largest)-1;largest);-1)
expect("integer wider than machine";(.try({.bitxor(2^wordBits;0)};[])@1)@"kind";"range")
expect("scalar on left";.bitxor(3;[0 1 2]);[3 2 1])
expect("scalar on right";.bitxor([0 1 2];3);[3 2 1])
expect("matrix";.bitxor([[1 2] [3 4]];[[4 3] [2 1]]);[[5 1] [1 5]])
expect("shared leading dimension";.bitxor([1 3];[[1 2] [3 4]]);[[0 3] [0 7]])
expect("empty integer vector";.bitxor([];-1);[])
expect("empty and empty";.bitxor([];[]);[])
expect("incompatible shapes";(.try({.bitxor([1 2];[1])};[])@1)@"kind";"shape")
expect("float";(.try({.bitxor(1.0;1)};[])@1)@"kind";"type")
expect("float array";(.try({.bitxor(1;[1.0 2.0])};[])@1)@"kind";"type")
expect("string";(.try({.bitxor("1";1)};[])@1)@"kind";"type")
expect("ragged list";(.try({.bitxor(1;[[1 2] [3]])};[])@1)@"kind";"type")
.p("PASS bitxor")
