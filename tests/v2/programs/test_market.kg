.l("./expect.kg")
.l("./market.kg")
expect("last trade by symbol";lastpx();[103 201 300])
expect("minute volume";minutes();[[0 7] [1 10]])
expect("as-of join at a tie, before the first quote and for an unknown symbol";bids();[98 -1 101 -1 101 198])
expect("retain both unmatched trades";unmatched();2)
expect("minute open high low close in time and sequence order";bars();[[200 201 100 201] [102 300 102 300]])
expect("volume-weighted price for BB";bbvwap();200.4)
expect("two-trade rolling volume resets at symbol boundaries";rollingqty();[2 3 6 1 9 5])
.insert(trades;[7 "AA" 57 999 1])
expect("a late trade does not replace a newer price";lastpx();[103 201 300])
.p("PASS market")
