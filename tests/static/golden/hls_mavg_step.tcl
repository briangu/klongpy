# hls_step.tcl - generated by KlongPy (kgpy fpga source). Do not edit.
# Run:  vitis_hls -f hls_step.tcl
# Environment:  KG_DATA  directory holding in.bin for the C simulation (default: this directory; out.bin and
#                        status.bin are written there)
#               KG_CHUNK records per kernel call in the C simulation (default 0: one call)
#               KG_NO_SYNTH  set to stop after the C simulation
#               KG_EXPORT  set to also run export_design -format xo (a Vitis kernel object)
set here [file dirname [file normalize [info script]]]
set data $here
if {[info exists ::env(KG_DATA)]} { set data $::env(KG_DATA) }
set chunk 0
if {[info exists ::env(KG_CHUNK)]} { set chunk $::env(KG_CHUNK) }
set cflags "-I$here -DKG_TRAP_FLAG=kg_hls_trap"
open_project -reset proj_step
set_top mavg_step_kernel
add_files $here/mavg.c -cflags $cflags
add_files $here/mavg_step_top.cpp -cflags $cflags
add_files -tb $here/mavg_step_tb.cpp -cflags $cflags
open_solution -reset sol1 -flow_target vitis
set_part {xcu250-figd2104-2L-e}
create_clock -period 3.333 -name default
if {[file exists $data/in.bin]} { csim_design -argv "$data $chunk" }
if {[info exists ::env(KG_NO_SYNTH)]} { exit }
csynth_design
if {[info exists ::env(KG_EXPORT)]} { export_design -format xo }
exit
