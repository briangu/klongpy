# The declarations of the static profile that an interpreter runs as they stand (docs/static-profile.md):
# .extern returns a function the host provides, .entry declares a function the program defines.
# A case runs in a fresh interpreter with no host function, so a call of an extern is a system error.
# Fixed-point values (.fixed) are not part of the suite.

# .extern(c_symbol;signature) returns a host-function value; the program assigns it (f::.extern("read_adc";"int -> float")). The C symbol
# names what the host registered; the Klong name is the program's own. A statement that discards the value is an error.

@ static.extern-is-a-value strings static
> f::.extern("read_adc";"int -> float")
> 1
= 1

@ static.extern-defines-no-name strings static strict2
# the C symbol is not a name of the program: only the name the program assigns exists
> f::.extern("tick";"-> int")
> tick
! name

@ static.extern-canonical-form-is-one-declaration strings static
> a::.extern("f";"int   float[8]->  void")
> b::.extern("f";"int float[8] -> void")
> 1
= 1

@ static.extern-array-result strings static
> f::.extern("fill";"float[64] -> float[16,4]")
> 1
= 1

@ static.extern-str-parameter strings static
> f::.extern("log";"str int -> void")
> 1
= 1

@ static.extern-no-parameters strings static
> f::.extern("tick";"-> int")
> 1
= 1

@ static.extern-the-value-can-be-kept-in-a-dictionary strings dicts static
> d:::{;"adc";.extern("read_adc";"int -> float")}
> d.adc(0)
! system

@ static.extern-statement-form-is-an-error strings static
# the value must be assigned: the old statement form declared a global
> .extern("read_adc";"int -> float")
> 1
! type

@ static.extern-statement-form-in-a-sequence-is-an-error strings static
> f::1;.extern("f";"int -> int");f
! type

@ static.extern-module-argument-is-gone strings static
> f::.extern("fill";"float[64] -> float[64]";"dsp")
! arity

@ static.extern-declared-twice-the-same strings static
> a::.extern("f";"int -> int")
> b::.extern("f";"int -> int")
> 1
= 1

@ static.extern-declared-twice-differently strings static
> a::.extern("f";"int -> int")
> b::.extern("f";"float -> int")
! type

@ static.extern-call-without-a-host-function strings static
> f::.extern("read_adc";"int -> float")
> f(0)
! system

@ static.extern-call-with-too-many-arguments strings static
> f::.extern("f";"int -> int")
> f(1;2)
! arity

@ static.extern-call-with-no-argument strings static
> f::.extern("f";"int -> int")
> f()
! arity

@ static.extern-more-than-three-parameters strings static
> g::.extern("g";"int int int int -> int")
> g(1;2;3;4)
! system

@ static.extern-more-than-three-too-many strings static
> g::.extern("g";"int int int int -> int")
> g(1;2;3;4;5)
! arity

@ static.extern-more-than-three-fewer-arguments-is-a-projection strings static
> g::.extern("g";"int int int int -> int")
> p::g(1;2;3)
> p(4)
! system

@ static.extern-six-parameters strings static
> g::.extern("g";"int int int int int int -> int")
> g(1;2;3;4;5;6)
! system

@ static.extern-six-parameters-too-many strings static
> g::.extern("g";"int int int int int int -> int")
> g(1;2;3;4;5;6;7)
! arity

@ static.extern-wide-function-is-a-value-in-a-dictionary strings dicts static
> d:::{;"g";.extern("g";"int int int int -> int")}
> d.g(1;2;3;4)
! system

@ static.extern-wide-function-two-declarations-are-independent strings static
> g::.extern("g4";"int int int int -> int")
> h::.extern("h5";"int int int int int -> int")
> h(1;2;3;4;5;6)
! arity

@ static.extern-wide-function-passed-as-an-argument strings static
> g::.extern("g";"int int int int -> int")
> apply(f)::{f(1;2;3;4)}
> apply(g)
! system

@ static.extern-name-is-a-string strings static
> f::.extern(1;"int -> int")
! type

@ static.extern-signature-is-a-string strings static
> f::.extern("f";1)
! type

@ static.extern-too-few-arguments strings static
> f::.extern("f")
! arity

@ static.extern-signature-without-arrow strings static
> f::.extern("f";"int")
! type

@ static.extern-signature-two-arrows strings static
> f::.extern("f";"int -> int -> int")
! type

@ static.extern-signature-unknown-type strings static
> f::.extern("f";"quux -> int")
! type

@ static.extern-signature-no-result strings static
> f::.extern("f";"int ->")
! type

@ static.extern-signature-void-parameter strings static
> f::.extern("f";"void -> int")
! type

@ static.extern-signature-str-result strings static
> f::.extern("f";"int -> str")
! type

@ static.extern-signature-zero-dimension strings static
> f::.extern("f";"int[0] -> int")
! type

@ static.extern-signature-five-dimensions strings static
> f::.extern("f";"int[1,2,3,4,5] -> int")
! type

# the C symbol: a C identifier (letters, digits and underscores, not starting with a digit), not a C keyword, no kg_ prefix, no dot

@ static.extern-symbol-with-an-underscore strings static
> f::.extern("a_b";"int -> int")
> 1
= 1

@ static.extern-symbol-with-a-dot strings static
> f::.extern("read.adc";"int -> float")
! type

@ static.extern-symbol-starts-with-a-digit strings static
> f::.extern("1a";"int -> int")
! type

@ static.extern-symbol-is-empty strings static
> f::.extern("";"int -> int")
! type

@ static.extern-symbol-with-a-space strings static
> f::.extern("a b";"int -> int")
! type

@ static.extern-symbol-with-a-hyphen strings static
> f::.extern("a-b";"int -> int")
! type

@ static.extern-symbol-is-a-c-keyword strings static
> f::.extern("int";"int -> int")
! type

@ static.extern-symbol-is-a-c-keyword-while strings static
> f::.extern("while";"int -> int")
! type

@ static.extern-symbol-of-the-runtime strings static
> f::.extern("kg_a";"int -> int")
! type

@ static.extern-symbol-kg-without-underscore-is-fine strings static
> f::.extern("kga";"int -> int")
> 1
= 1

@ static.extern-symbol-is-a-symbol-value strings static
> f::.extern(:read_adc;"int -> float")
! type

@ static.entry-returns-the-signature strings static
> step::{x*2};.entry("step";"float -> float")
= "float -> float"

@ static.entry-canonical-form strings static
> step::{x+y};.entry("step";"int   int->int")
= "int int -> int"

@ static.entry-named-parameters strings static
> step(a;b;c;d)::{a+b+c+d};.entry("step";"int int int int -> int")
= "int int int int -> int"

@ static.entry-no-parameters strings static
> step()::{7};.entry("step";"-> int")
= "-> int"

@ static.entry-array-types strings static
> run::{+/x};.entry("run";"float[256] -> float")
= "float[256] -> float"

@ static.entry-twice-with-different-shapes strings static
> step::{x*2};.entry("step";"int -> int");.entry("step";"float -> float")
= "float -> float"

@ static.entry-does-not-change-the-function strings static
> step::{x*2};.entry("step";"int -> int");step(21)
= 42

@ static.entry-undefined-function strings static
> .entry("nope";"int -> int")
! name

@ static.entry-not-a-function strings static
> v::3;.entry("v";"int -> int")
! type

@ static.entry-projection strings static
> h::{x+y};p::h(1;);.entry("p";"int -> int")
! type

@ static.entry-system-function strings static
> .entry(".p";"int -> int")
! type

@ static.entry-too-many-parameters strings static
> step::{x*2};.entry("step";"int int -> int")
! arity

@ static.entry-too-few-parameters strings static
> step::{x+y};.entry("step";"int -> int")
! arity

@ static.entry-str-parameter strings static
> step::{x};.entry("step";"str -> int")
! type

@ static.entry-signature-without-arrow strings static
> step::{x};.entry("step";"int")
! type

@ static.entry-reserved-name strings static
> init::{x};.entry("init";"int -> int")
! type

@ static.entry-name-is-a-string strings static
> step::{x};.entry(:step;"int -> int")
! type

@ static.entry-an-extern-is-not-defined-by-the-program strings static
> f::.extern("f";"int -> int");.entry("f";"int -> int")
! type

# .float converts an int or an array of numbers to float; .param declares a tunable input register.

@ static.float-of-an-int strings float static
> .float(3)
= 3.0

@ static.float-of-a-float strings float static
> .float(2.5)
= 2.5

@ static.float-of-an-int-array strings float static
> .float([1 2 3])
= [1.0 2.0 3.0]

@ static.float-of-a-float-array strings float static
> .float([1.5 2.5])
= [1.5 2.5]

@ static.float-of-a-matrix strings float static
> .float([[1 2] [3 4]])
= [[1.0 2.0] [3.0 4.0]]

@ static.float-of-a-string strings float static
> .float("a")
! type

@ static.float-of-a-symbol strings float static
> .float(:a)
! type

@ static.param-returns-the-type strings static
> .param("window";"int";4)
= "int"

@ static.param-defines-the-global-with-its-default strings static
> .param("window";"int";4);window
= 4

@ static.param-default-is-zero strings static
> .param("n";"int");n
= 0

