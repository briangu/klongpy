@ modules.export-is-a-snapshot strings dicts sysio qualified modules
# DECISION: .export copies values at the call. Exporting a variable exports its value then, not the variable; state is reached through functions
# m.kg: n::0
# m.kg: inc()::{n::n+1;n}
# m.kg: .export(:{;"n";n;"inc";inc})
> kgw(p;t)::{[c];c::.oc(p);.tc(c);{.p(x)}'t;.tc(0);.cc(c)}
> kgw("/tmp/kgm87-export-is-a-snapshot-m.kg";["n::0" "inc()::{n::n+1;n}" ".export(:{;""n"";n;""inc"";inc})"])
> m::.import("/tmp/kgm87-export-is-a-snapshot-m")
> m.inc()
> kgr::m.n
> .df("/tmp/kgm87-export-is-a-snapshot-m.kg")
> kgr
= 0

@ modules.exported-function-keeps-its-module-scope strings dicts sysio qualified modules
