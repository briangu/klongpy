= 2

@ modules.system-function-calls-are-unchanged strings dicts qualified
> .fmt("{}";5)
= "5"

@ modules.assignment-to-undeclared-in-function-level0 strings dicts qualified
# a is a declared local that was never assigned: undefined. At level 0 a.b::1 used to make a local variable named a.b
> zz::{[a];a.b::1}
> zz()
! name

@ modules.import-basic strings dicts sysio qualified modules
# m.kg: f(n)::{n+1}
# m.kg: .export(:{;"f";f})
> kgw(p;t)::{[c];c::.oc(p);.tc(c);{.p(x)}'t;.tc(0);.cc(c)}
> kgw("/tmp/kgm87-import-basic-m.kg";["f(n)::{n+1}" ".export(:{;""f"";f})"])
> m::.import("/tmp/kgm87-import-basic-m")
> kgr::m.f(1)
> .df("/tmp/kgm87-import-basic-m.kg")
> kgr
= 2

@ modules.import-returns-the-export-dictionary strings dicts sysio qualified modules
