> kgw(p;t)::{[c];c::.oc(p);.tc(c);{.p(x)}'t;.tc(0);.cc(c)}
> kgw("/tmp/kgm87-static-declarations-are-inert-m.kg";["run(v)::{v*2.0}" ".entry(""run"";""float -> float"")" "export:::{;""run"";run}"])
> .l("/tmp/kgm87-static-declarations-are-inert-m";:m)
> kgr::m.run(4.0)
> .df("/tmp/kgm87-static-declarations-are-inert-m.kg")
> kgr
= 8.0

