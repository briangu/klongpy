@ modules.call-two strings dicts qualified
> d:::{;"g";{x-y}}
> d.g(10;3)
= 7

@ modules.call-zero strings dicts qualified
# a niladic function literal written inside :{;...} is called there, so the entry is a name that holds one
> h::{7}
> d:::{;"h";h}
> d.h()
= 7

