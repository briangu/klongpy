@ modules.load-alias-basic strings dicts sysio qualified modules
# m.kg: f(n)::{n+1}
# m.kg: export:::{;"f";f}
> kgw(p;t)::{[c];c::.oc(p);.tc(c);{.p(x)}'t;.tc(0);.cc(c)}
> kgw("/tmp/kgm87-load-alias-basic-m.kg";["f(n)::{n+1}" "export:::{;""f"";f}"])
> .l("/tmp/kgm87-load-alias-basic-m";:m)
> kgr::m.f(1)
> .df("/tmp/kgm87-load-alias-basic-m.kg")
> kgr
= 2

