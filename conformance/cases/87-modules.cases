@ modules.digit-segment-is-a-syntax-error strings dicts qualified
# a.5 was a variable name; a segment must start with a letter, so write a@5. Decision for the owner: syntax error rather than a silent classic variable
> a::[1 2]
> a.5
! syntax

@ modules.trailing-dot-is-a-syntax-error strings dicts qualified
> d:::{;"a";1}
> d.a.
! syntax

@ modules.space-breaks-the-name strings dicts qualified
# d .zz is d followed by the name .zz, as today
> d:::{;"a";1}
