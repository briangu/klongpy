> f().zz
! name

@ modules.leading-dot-names-are-whole strings dicts qualified
# a name that starts with a dot is one name, never qualified: .srv.o .cli.h .os.argv .fpga.set
> .zz.a::5
> .zz.a
= 5

@ modules.leading-dot-hook-with-named-parameters strings dicts qualified
> .hk.o(h)::{h+1}
