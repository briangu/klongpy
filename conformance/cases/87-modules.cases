@ modules.write-through-alias strings dicts qualified
# dictionaries are shared, as with , today; principle 4 is not served, the language decision stands
> d:::{;"a";1}
> e::d
> e.a::6
> d.a
= 6

@ modules.write-through-nested-alias strings dicts qualified
# d.a is the nested dictionary itself, not a copy
> d:::{;"a";:{;"b";1}}
> s::d.a
> s.b::5
> d.a.b
= 5

@ modules.write-is-not-a-variable strings dicts qualified
> d:::{;"a";1}
> d.a::5
> :_(d.a)
= 0

@ modules.write-in-function-to-global-dict strings dicts qualified
