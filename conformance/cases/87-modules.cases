# Modules: .import, .export and qualified names a.b. Generated by conformance/tools/gen_modules.py: edit the generator, not this file.
# docs/design-principles.md decides every open question; a `why` line names the principle.
#
# Tags: qualified = a.b on dictionaries (reading, writing, calling); modules = .import and .export
# (a case writes its module files into /tmp with .oc .tc .p .cc and deletes them with .df, hence strings dicts sysio).
# Macros in the comments: {P} is the absolute path, {R} the ./ path, {U} the ../tmp/ path and {B} the bare name of the case's own files.
# A case that fails leaves /tmp/kgm87-* files behind (the runner stops at the first error). File names are unique per case.
# Error kinds: a missing key is `name`; a base that is not a dictionary and writing to a read-only dictionary are `type`;
# every failure of the module graph (missing file, cycle, no .export, a bare name not on the library path) is `system`.

@ modules.read strings dicts qualified
# d.a is d@"a"
> d:::{;"a";1}
> d.a
= 1

@ modules.read-nested strings dicts qualified
> d:::{;"a";:{;"b";2}}
> d.a.b
= 2

@ modules.read-three-deep strings dicts qualified
> d:::{;"a";:{;"b";:{;"c";3}}}
> d.a.b.c
= 3

@ modules.read-in-expression strings dicts qualified
> d:::{;"a";4}
> (d.a*2)+d.a
= 12

@ modules.read-then-index strings dicts qualified
# d.l@1 is (d.l)@1: the name is d.l
> d:::{;"l";[10 20 30]}
> d.l@1
= 20

@ modules.read-under-monads strings dicts qualified
> d:::{;"l";[10 20 30]}
> (#d.l),*d.l
= [3 10]

@ modules.read-letters-and-digits strings dicts qualified
> d:::{;"a1";3}
> d.a1
= 3

@ modules.read-float-entry strings dicts qualified float
> d:::{;"a";1.5}
> d.a+2.5
= 4.0

@ modules.read-key-case-sensitive strings dicts qualified
> d:::{;"A";1}
> d.a
! name

@ modules.read-missing-key strings dicts qualified
# decision 7 of the design: a missing key is a name error naming the dictionary and the key
> d:::{;"a";1}
> d.b
! name

@ modules.read-missing-key-nested strings dicts qualified
> d:::{;"a";:{;"b";1}}
> d.a.c
! name

@ modules.at-still-gives-undefined strings dicts qualified
# @ keeps the classic answer: only a.b is loud
> d:::{;"a";1}
> :_(d@"b")
= 1

@ modules.present-key-with-undefined-value strings dicts qualified
# the key is present, so a.b answers its value, which is :undefined
> d:::{;"a";1%0}
> :_(d.a)
= 1

@ modules.symbol-key-is-not-the-string-key strings dicts qualified
# a.b is d@"b" with a string key
> d:::{;:a;1}
> d.a
! name

@ modules.key-with-dot-by-at strings dicts qualified
> d:::{;"a.b";1}
> d@"a.b"
= 1

@ modules.key-with-dot-not-reachable-by-dots strings dicts qualified
> d:::{;"a.b";1}
> d.a
! name

