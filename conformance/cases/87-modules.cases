@ modules.export-twice strings dicts sysio qualified modules
# m.kg: .export(:{;"a";1})
# m.kg: .export(:{;"b";2})
> kgw(p;t)::{[c];c::.oc(p);.tc(c);{.p(x)}'t;.tc(0);.cc(c)}
