# Short calls: a call with fewer arguments than the function
# takes is a projection over the missing trailing arguments, the same value
# as the call written with the empty slots. It is allowed at every strict
# level; too many arguments is an arity error at level 2.
@ shortcall.dyad-one-argument core
> r::{x+y}
> s::r(1)
> s(10)
= 11

@ shortcall.same-as-empty-slot core
> r::{x-y}
> s::r(10)
> t::r(10;)
> s(3),t(3)
= [7 7]

@ shortcall.y-only-function core
> f::{y}
> p::f(5)
> p(6)
= 6

@ shortcall.literal core
> p::{x+y}(1)
> p(2)
= 3

@ shortcall.triad-one-argument core
> g::{x,y,z}
> h::g(1)
> h(2;3)
= [1 2 3]

@ shortcall.triad-two-arguments core
> g::{x,y,z}
> h::g(1;2)
> h(3)
= [1 2 3]

@ shortcall.triad-step-by-step core
> g::{x,y,z}
> h::g(1)
> i::h(2)
> i(3)
= [1 2 3]

@ shortcall.slot-then-missing-trailing core
> g::{x,y,z}
> h::g(;2)
> h(1;3)
= [1 2 3]

@ shortcall.projection-of-projection-fills-first-slot core
> f::{x,y,z}
> p::f(1)
> q::p(;3)
> q(2)
= [1 2 3]

@ shortcall.no-arguments core
> g::{x,y}
> h::g()
> h(1;2)
= [1 2]

@ shortcall.under-each core
> r::{x+y}
> s::r(1)
> s'[1 2 3]
= [2 3 4]

@ shortcall.made-in-a-function-holds-its-values core
> f::{x+y}
> mk::{f(x)}
> p::mk(5)
> p(10)
= 15

@ shortcall.each-makes-projections core
> f::{x+y}
> {x(10)}'{f(x)}'[1 2 3]
= [11 12 13]

@ shortcall.at-with-one-value core
> f::{x-y}
> p::f@10
> p(3)
= 7

@ shortcall.named-parameters core
> f(a;b)::{a+b}
> g::f(1)
> g(2)
= 3

@ shortcall.named-parameters-levels core
> f(a;b;c;d;e)::{a,b,c,d,e}
> p::f(1;2)
> q::p(3)
> r::q(4)
> r(5)
= [1 2 3 4 5]

@ shortcall.display-remaining-arity-short core
> f::{y}
> f(5)
= :monad

@ shortcall.display-remaining-arity-slot core
> g::{x+y}
> g(1;)
= :monad

@ shortcall.display-triad-one-argument core
> g::{x+y+z}
> g(1)
= :dyad

@ shortcall.display-function-unchanged core
> g::{x+y}
> g
= :dyad

@ shortcall.strict1 core strict1
> r::{x+y}
> s::r(1)
> s(10)
= 11

@ shortcall.strict2-is-a-projection core strict2
> r::{x+y}
> s::r(1)
> s(10)
= 11

@ shortcall.strict2-named core strict2
> f(a;b)::{a+b}
> g::f(1)
> g(2)
= 3

@ shortcall.strict2-too-many-is-an-error core strict2
> r::{x+y}
> r(1;2;3)
! arity

@ shortcall.strict2-too-many-for-the-projection core strict2
> r::{x+y}
> s::r(1)
> s(2;3)
! arity
