# Named parameters f(a;b)::{...}
@ named.four-parameters core
> f(a;b;c;d)::{(a*1000)+(b*100)+(c*10)+d}
> f(1;2;3;4)
= 1234

@ named.no-parameters core
> f()::{42}
> f()
= 42

@ named.one-parameter core
> f(a)::{a*2}
> f(21)
= 42

@ named.six-parameters core
> f(a;b;c;d;e;g)::{[;g;e;d;c;b;a]}
> f(1;2;3;4;5;6)
= [6 5 4 3 2 1]

@ named.parameters-are-local core
> a::100
> b::200
> f(a;b)::{a+b}
> f(1;2)+a+b
= 303

@ named.assigning-a-parameter-is-local core
> a::100
> g(a)::{a::a+1;a}
> g(1)+a
= 102

@ named.locals-list core
> f(a;b)::{[t];t::a;t+b}
> f(1;2)
= 3

@ named.head-destructuring core
> f(v;k)::{[p q]::v;k*p+q}
> f([1 2];10)
= 30

@ named.x-in-a-nested-function core
> f(a;b)::{{x}(a)+b}
> f(1;2)
= 3

@ named.nested-function-reads-parameters core
> f(a;b)::{{x+b}'a}
> f([1 2 3];10)
= [11 12 13]

@ named.arguments-evaluated-in-order core
> n::0
> t()::{n::n+1;n}
> f(a;b;c;d)::{[;a;b;c;d]}
> f(t();t();t();t())
= [1 2 3 4]

@ named.projection-with-holes core
> f(a;b;c;d)::{(a*1000)+(b*100)+(c*10)+d}
> g::f(1;;;4)
> g(2;3)
= 1234

@ named.projection-first-and-last-open core
> f(a;b;c;d)::{(a*1000)+(b*100)+(c*10)+d}
> g::f(;2;3;)
> g(1;4)
= 1234

@ named.projection-of-a-projection core
> f(a;b;c;d)::{(a*1000)+(b*100)+(c*10)+d}
> g::f(1;;;4)
> h::g(2;)
> h(3)
= 1234

@ named.projection-five-levels core
> f(a;b;c;d;e;g)::{[;a;b;c;d;e;g]}
> p1::f(1;;;;;)
> p2::p1(2;;;;)
> p3::p2(3;;;)
> p4::p3(4;;)
> p5::p4(5;)
> p5(6)
= [1 2 3 4 5 6]

@ named.projection-list-argument core
> f(a;b;c;d)::{a,b,c,d}
> g::f([1 2];;[3 4];)
> g(0;9)
= [1 2 0 3 4 9]

@ named.projection-under-each core
> f(a;b;c;d)::{a+b+c+d}
> f(1;2;3;)'[1 2 3]
= [7 8 9]

@ named.apply-spreads-a-list core
> f(a;b;c;d)::{a+b+c+d}
> f@[1 2 3 4]
= 10

@ named.apply-one-argument core
> f(a)::{a*2}
> f@21
= 42

@ named.monad-under-each core
> sq(a)::{a*a}
> sq'[1 2 3]
= [1 4 9]

@ named.dyad-under-over core
> add(a;b)::{a+b}
> add/[1 2 3 4]
= 10

@ named.dyad-under-each-2 core
> add(a;b)::{a+b}
> [1 2 3]add'[10 20 30]
= [11 22 33]

@ named.dyad-infix core
> sub(a;b)::{a-b}
> 5 sub 3
= 2

@ named.recursion-by-name core
> fact(n;acc)::{:[n<1;acc;fact(n-1;acc*n)]}
> fact(5;1)
= 120

@ named.recursion-by-dot-f core
> fact(n;acc)::{:[n<1;acc;.f(n-1;acc*n)]}
> fact(5;1)
= 120

@ named.redefinition core
> f(a;b)::{a+b}
> f(a;b;c)::{a*b*c}
> f(2;3;4)
= 24

@ named.function-as-a-value core
> f(a;b;c;d)::{a+b+c+d}
> ap(fn;v)::{fn(v;v;v;v)}
> ap(f;2)
= 8

@ named.too-many-arguments core
> f(a;b)::{a+b}
> f(1;2;3)
! arity

@ named.too-many-arguments-nilad core
> f()::{1}
> f(1)
! arity

@ named.too-many-for-a-projection core
> f(a;b;c;d)::{a+b+c+d}
> g::f(1;;;4)
> g(2;3;5)
! arity

@ named.apply-too-many core
> f(a;b)::{a+b}
> f@[1 2 3]
! arity

@ named.apply-too-few core
> f(a;b;c;d)::{a+b+c+d}
> f@[1 2]
! arity

@ named.four-parameters-under-each core
> f(a;b;c;d)::{a+b+c+d}
> f'[1 2 3]
! arity

@ named.four-parameters-under-over core
> f(a;b;c;d)::{a+b+c+d}
> f/[1 2 3]
! arity

@ named.body-must-be-a-function core
> f(a;b)::5
! syntax

@ named.body-must-be-a-function-not-an-expression core
> f(a;b)::a+b
! syntax

@ named.x-in-the-body core
> f(a;b)::{x}
! syntax

@ named.z-in-the-body core
> f(a;b)::{a+z}
! syntax

@ named.strict1-definition-and-call core strict1
> f(a;b;c;d)::{[t];t::a+b;t+c+d}
> f(1;2;3;4)
= 10

@ named.strict1-reserved-parameter-name core strict1
> f(a;x)::{a}
! syntax

@ named.strict1-duplicate-parameter-name core strict1
> f(a;a)::{a}
! syntax

@ named.strict1-argument-that-is-not-a-name core strict1
> f(a;1)::{a}
! syntax

@ named.strict2-definition-and-call core strict2
> f(a;b;c;d)::{[t];t::a+b;t+c+d}
> f(1;2;3;4)
= 10

@ named.strict2-too-many-arguments core strict2
> f(a;b)::{a+b}
> f(1;2;3)
! arity

# Lexical scope of a function with named parameters (docs/design-principles.md, principle 4: a name is read from where it was written,
# not from whoever called). Its body reads its parameters, its declared locals and then the globals of its module; the locals of its caller
# are not visible. A function without a parameter list ({x+y}) keeps the dynamic scope of Klong.

@ named.reads-the-global-not-the-callers-local core
> g(a)::{a+b}
> f::{[b];b::10;g(1)}
> b::100
> f()
= 101

@ named.callers-local-is-not-visible-at-level-1 core strict1
> g(a)::{a+b}
> f::{[b];b::10;g(1)}
> f()
! name

@ named.callers-local-is-not-visible-at-level-2 core strict2
> g(a)::{a+b}
> f::{[b];b::10;g(1)}
> f()
! name

@ named.reads-its-own-locals core
> g(a)::{[t];t::a*2;t+1}
> g(4)
= 9

@ named.reads-the-global-it-was-defined-with core
> k::7
> g(a)::{a+k}
> g(1)
= 8

@ named.a-lambda-inside-reads-the-locals-of-its-function core
> g(a)::{[t];t::a;{x+t}(1)}
> g(5)
= 6

@ named.a-lambda-in-an-adverb-reads-the-locals-of-its-function core
> g(a)::{[t];t::a;{x+t}'[1 2]}
> g(5)
= [6 7]

@ named.parameters-are-visible-to-a-lambda-inside core
> g(a;b)::{{x+a+b}(1)}
> g(10;100)
= 111

@ named.a-callback-reads-the-locals-of-the-function-that-wrote-it core
> ap(f;a)::{f(a)}
> h::{[off];off::10;ap({x+off};1)}
> h()
= 11

@ named.a-classic-function-keeps-dynamic-scope core
> g::{x+b}
> f::{[b];b::10;g(1)}
> f()
= 11

@ named.a-classic-function-called-by-a-named-one-sees-the-named-locals core
> g::{t}
> n(a)::{[t];t::a*3;g()}
> n(4)
= 12

@ named.a-named-function-does-not-see-through-a-classic-caller core
> g(a)::{a+b}
> c::{[b];b::10;g(1)}
> b::0
> c()
= 1

@ named.a-named-function-does-not-see-the-locals-of-a-named-caller core
> g(a)::{a+t}
> n(a)::{[t];t::50;g(a)}
> t::1
> n(1)
= 2

@ named.recursion-reads-its-own-frames core
> f(n)::{:[n<2;n;f(n-1)+f(n-2)]}
> f(10)
= 55

@ named.a-projection-keeps-the-scope core
> add(a;b)::{a+b+k}
> k::100
> p::add(1;)
> q::{[k];k::5;p(2)}
> q()
= 103

@ named.a-local-assignment-stays-local core
> g(a)::{[t];t::a;t}
> t::9
> g(4)
> t
= 9
