:" euclidean distance "
ed(p;pts)::{{(+/(x-p)^2)^0.5}'pts}

:" the indices of the k points of pts nearest to point "
knn(k;point;pts)::{k#<ed(point;pts)}

:" test data "
data::[[1 2] [2 3] [3 4] [5 5] [1 4] [2 5]]

:" test point "
tp::[3 3]

:" number of neighbors "
k::3

:" Find the k-nearest neighbors "
neighbors::knn(k;tp;data)

:" Output the indices of the nearest neighbors "
.pf("Indices of the k-nearest neighbors: {}";,neighbors)
