:" Historical IPC server. kg hdb.kg LISTEN-ADDRESS. Only completed sessions appear in trades."
history::.db("history.duckdb")
history("SET threads=least(current_setting('threads')::INTEGER,4)")
history("CREATE TABLE IF NOT EXISTS trades(dayno BIGINT,seq BIGINT,ts BIGINT,sym BIGINT,px BIGINT,qty BIGINT)")
history("CREATE TABLE IF NOT EXISTS closed_days(dayno BIGINT PRIMARY KEY,n BIGINT,first_seq BIGINT,last_seq BIGINT)")
history("CREATE TABLE IF NOT EXISTS closing_quotes(dayno BIGINT,sym BIGINT,seq BIGINT,px BIGINT,PRIMARY KEY(dayno,sym))")
num(n)::{:[n~(0:$($n));$n;.err("range";"integer required")]}
dayBounds(day)::{history("SELECT n,first_seq,last_seq FROM closed_days WHERE dayno=",num(day))}
archived(day)::{[bounds];bounds::dayBounds(day);:[#bounds;bounds;history("SELECT count(*),coalesce(min(seq),-1),coalesce(max(seq),-1) FROM trades WHERE dayno=",num(day))]}
historyStats(day)::{history("SELECT count(*),coalesce(sum(seq),0),coalesce(sum(px),0),coalesce(sum(qty),0) FROM trades WHERE dayno=",num(day))}
historyQuote(day;sym)::{[condition hit];condition::" WHERE dayno=",(num(day))," AND sym=",num(sym);
    hit::history("SELECT seq,px FROM closing_quotes",condition);
    :[#hit;hit:|#dayBounds(day);[];history("SELECT seq,px FROM trades",condition," ORDER BY seq DESC LIMIT 1")]}
historyFrom(day;first;n)::{:[(n>0)&n<65537;1;.err("range";"request 1 to 65536 rows")];
    history("SELECT seq,ts,sym,px,qty FROM trades WHERE dayno=",(num(day))," AND seq>=",(num(first))," ORDER BY seq LIMIT ",num(n))}
seal(day;first;stop)::{[span found src reply problem];span::[;stop-first;first;stop-1];found::archived(day);
    :[span~found;stop;{:[0=*found;1;.err("range";"conflicting archived session")];
        src::"read_parquet('transfer/day-",(num(day)),".parquet')";
        :[span~history("SELECT count(*),min(seq),max(seq) FROM ",src);1;.err("range";"invalid closing watermark")];
        history("BEGIN");
        reply::.try({history("INSERT INTO trades SELECT ",(num(day)),",seq,ts,sym,px,qty FROM ",src);
            history("INSERT INTO closing_quotes SELECT dayno,sym,max(seq),arg_max_null(px,seq) FROM trades WHERE dayno=",(num(day))," GROUP BY dayno,sym");
            history("INSERT INTO closed_days VALUES (",(num(day)),",",(num(stop-first)),",",(num(first)),",",(num(stop-1)),")");
            history("COMMIT");stop};[]);
        :[reply@0;stop;{problem::reply@1;history("ROLLBACK");.err(problem@"kind";problem@"message")}()]}()]}
:[1=#.a;.srv(.a@0);1]
