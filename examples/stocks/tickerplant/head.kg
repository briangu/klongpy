:" IPC head and current trading session. Run from the data directory, with a transfer/ directory.
   kg head.kg LISTEN-ADDRESS HDB-ADDRESS [WAL-DIRECTORY [INITIAL-DAY FIRST-SEQUENCE]]. Loading without arguments installs the functions."
live::0;buffers:::{};widths::2^!17;nextSeq::0;dayFirst::0;dayNo::0;closing::0
journalDir::"log";journalAddr::"";wal::0;ready::0;histAddr::0;subs:::{};lostSubs::0;recentFirst::0
need(ok;message)::{:[ok;1;.err("range";message)]}
number(n)::{need(n~(0:$($n));"integer required");$n}
part(day)::{"transfer/day-",(number(day)),".parquet"}
discardTransfer(day)::{.try({.df(part(day))};[]);1}
cols(ids;ts;sym;px;qty)::{:{;"seq";ids;"ts";ts;"sym";sym;"px";px;"qty";qty}}
bufferName(width)::{"batch",$width}
makeBuffer(width)::{[zeros];zeros::width#0;buffers,[;bufferName(width);.table(cols(zeros;zeros;zeros;zeros;zeros))];1}
insertBlock(first;ts;sym;px;qty)::{[n width name buf ids data sql];n::#ts;width::*widths@&widths>n-1;
    name::bufferName(width);buf::buffers@name;ids::first+!width;
    data:::[n=width;cols(ids;ts;sym;px;qty);cols(ids;width#ts;width#sym;width#px;width#qty)];
    {buf,x}'data;
    sql::"INSERT INTO rdb.ticks SELECT seq,ts,sym,px,qty FROM ",name;
    live(:[n=width;sql;sql," WHERE seq<",number(first+n)]);1}
insertChunk(chunk;first;ts;sym;px;qty)::{[offset which];offset::65536*chunk;
    which::offset+!65536&(#ts)-offset;insertBlock(first+offset;ts@which;sym@which;px@which;qty@which)}
insertLarge(first;ts;sym;px;qty)::{[chunks];chunks::1+((#ts)-1):%65536;
    {insertChunk(x;first;ts;sym;px;qty)}'!chunks;1}
insertBatch(first;ts;sym;px;qty)::{[n];n::#ts;
    :[n>65536;insertLarge(first;ts;sym;px;qty);insertBlock(first;ts;sym;px;qty)]}
quoteSymbols::[];quotePrices::[]
rememberQuotes(sym;px)::{[count];count::2048&#sym;quoteSymbols::(-count)#sym;quotePrices::(-count)#px;1}
replayBatch(batch)::{[first];first::batch@0;need(first~nextSeq;"WAL sequence gap");
    insertBatch(first;batch@1;batch@2;batch@3;batch@4);
    rememberQuotes(batch@2;batch@3);recentFirst::first;nextSeq::first+#(batch@1);wal([;:read;nextSeq])}
openJournal()::{[state batch peer];wal:::[#journalAddr;{peer::.cli(journalAddr);.clit(peer;180);peer}();.tickerwal(journalDir)];
    state::wal([;:open;0]);dayNo::state@0;dayFirst::state@1;closing::state@2;
    nextSeq::dayFirst;recentFirst::dayFirst;batch::wal([;:read;nextSeq]);
    {#x} replayBatch:~batch;1}
startHead(address)::{histAddr::address;quoteSymbols::[];quotePrices::[];makeBuffer'widths;live::.db(buffers);
    live("SET threads=least(current_setting('threads')::INTEGER,4)");live("SET temp_directory=''");
    need(0=live("SELECT count(*) FROM glob('rdb.duckdb')");"finish the legacy rdb.duckdb rollover and use a fresh head directory");
    live("ATTACH ':memory:' AS rdb");
    live("CREATE TABLE rdb.ticks(seq BIGINT NOT NULL,ts BIGINT NOT NULL,sym BIGINT NOT NULL,px BIGINT NOT NULL,qty BIGINT NOT NULL)");
    :[#journalDir;openJournal();1];:[dayNo>0;discardTransfer(dayNo-1);0];ready::1;nextSeq}
healthy()::{need(ready;"restart the head to replay the WAL")}
logBatch(first;ts;sym;px;qty)::{[receipt];receipt::wal([;:append;dayNo;first;ts;sym;px;qty]);
    :[receipt~-1;{ready::1;.err("type";"WAL requires four signed integer vectors within the IPC record limit")}();
        need((first+#ts)~receipt;"WAL watermark mismatch")]}
subscribe(dummy)::{healthy();.clit(.cli.h;2);subs,[;.cli.h;1];nextSeq}
deliver(pair;msg;until)::{[handle reply];handle::pair@0;reply::.try({handle(msg)};[]);
    :[(reply@0)&(until~reply@1);:{;handle;1};{lostSubs::lostSubs+1;:{}}()]}
fanout(msg;until)::{subs::,/{deliver(x;msg;until)}'subs;1}
publish(first;ts;sym;px;qty)::{[n reply];healthy();n::#ts;
    need(~closing;"finish the pending rollover first");need(first~nextSeq;"unexpected first sequence");
    need((n>0)&((#sym)=n)&((#px)=n)&((#qty)=n);"nonempty equal-length columns required");
    live("BEGIN");
    reply::.try({insertBatch(first;ts;sym;px;qty);
        ready::0;:[#journalDir;logBatch(first;ts;sym;px;qty);1];
        live("COMMIT");1};[]);
    :[reply@0;1;{live("ROLLBACK");.err(reply@1)}()];
    :[#journalDir;rememberQuotes(sym;px);{quoteSymbols::[];quotePrices::[]}()];recentFirst::first;nextSeq::first+n;ready::1;:[#subs;fanout([;:onTicks;first;ts;sym;px;qty];nextSeq);0];nextSeq}
sqlQuote(key)::{[query result];query::"SELECT seq,px FROM rdb.ticks WHERE sym=",key;
    result::live(query," AND seq>=",(number(recentFirst))," ORDER BY seq DESC LIMIT 1");
    :[(#result)|recentFirst=dayFirst;result;live(query," ORDER BY seq DESC LIMIT 1")]}
latest(sym)::{[key hits idx];healthy();key::number(sym);hits::quoteSymbols?sym;
    :[#hits;{idx::hits@((#hits)-1);[;(nextSeq-#quoteSymbols)+idx;quotePrices@idx]}();sqlQuote(key)]}
ticksFrom(first;n)::{healthy();need((n>0)&n<65537;"request 1 to 65536 rows");
    live("SELECT * FROM rdb.ticks WHERE seq>=",(number(first))," ORDER BY seq LIMIT ",number(n))}

liveStats()::{healthy();live("SELECT count(*),coalesce(sum(seq),0),coalesce(sum(px),0),coalesce(sum(qty),0) FROM rdb.ticks")}
closeSession()::{[path peer reply problem];need(nextSeq>dayFirst;"empty session");
    ready::0;:[#journalDir;need(nextSeq~wal([;:beginClose;dayNo;nextSeq]);"WAL close watermark mismatch");1];
    closing::1;ready::1;path::part(dayNo);
    live("COPY rdb.ticks TO '",path,"' (FORMAT PARQUET, PARQUET_VERSION V2)");
    peer::.cli(histAddr);.clit(peer;180);reply::.try({peer([;:seal;dayNo;dayFirst;nextSeq])};[]);.clic(peer);
    :[reply@0;1;{problem::reply@1;.err(problem@"kind";problem@"message")}()];
    need(nextSeq~reply@1;"HDB did not confirm the closing watermark");
    ready::0;:[#journalDir;need(nextSeq~wal([;:finishClose;dayNo;nextSeq]);"WAL seal watermark mismatch");1];
    live("DELETE FROM rdb.ticks");
    quoteSymbols::[];quotePrices::[];dayNo::dayNo+1;dayFirst::nextSeq;recentFirst::nextSeq;closing::0;ready::1;discardTransfer(dayNo-1);nextSeq}
roll(day)::{healthy();:[day~dayNo;closeSession():|(dayNo>0)&(day~dayNo-1);dayFirst;.err("range";"unexpected trading session")]}
setJournal(path)::{need(0<#path;"journal directory required");
    :[("127.0.0.1:"~10#path)|("localhost:"~10#path);journalAddr::path;journalDir::path]}
coordinate(s)::{[n];n::0:$s;need((s~$n)&n>-1;"expected a nonnegative integer checkpoint coordinate");n}
:[3=#.a;setJournal(.a@2):|5=#.a;journalDir::[;.a@2;coordinate(.a@3);coordinate(.a@4)];0]
:[((2=#.a)|3=#.a)|5=#.a;{startHead(.a@1);.srv(.a@0)}();1]
