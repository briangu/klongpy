.pyf("numpy";["log" "sqrt" "exp" "pi"])

:" normal cdf "
erf::{(2%sqrt(pi))*(x-((x^3)%3)+((x^5)%10)-((x^7)%42)+((x^9)%216))}
ncdf::{(1+erf(x%sqrt(2)))%2}

:" Option delta computed via Black-Scholes "
optiondelta(opt)::{[s k r t iv]::opt;ncdf((log(s%k)+(r+0.5*iv^2)*t)%(iv*sqrt(t)))}

:" test the option delta "
d::optiondelta([100 100 0.05 1 0.2])
.pf("expecting: 0.6368306511756191 computed: {}";,d)
d::optiondelta([[100] [100] [0.05] [1] [0.2]])
.pf("expecting: 0.6368306511756191 computed: {}";,d)

:" Option price computed via Black-Scholes "
pricefn(s;k;r;t;iv)::{[d1 d2];d1::(log(s%k)+(r+0.5*iv^2)*t)%(iv*sqrt(t));d2::d1-iv*sqrt(t);(s*ncdf(d1))-(k*exp((-r)*t)*ncdf(d2))}
optionprice(opt)::{[s k r t iv]::opt;pricefn(s;k;r;t;iv)}

:" test the option price "
d::optionprice([100 100 0.05 1 0.2])
.pf("expecting: 10.4506 computed: {}";,d)

d::optionprice([[100] [100] [0.05] [1] [0.2]])
.pf("expecting: 10.4506 computed: {}";,d)

