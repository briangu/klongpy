.py("klongpy.db")
.pyf("numpy";["std" "mean"])
.l("yfinance.kg")

T::fetch("MSFT";"2020-01-01"; "2023-01-01")

:" get close prices "
close::T?"Close"

:" compute close price stats "
.pf("average close{}";mean(close))
.pf("standard deviation{}";std(close))

:" break the close array up intow windows of size k "
.py("mkwindows.py")
k::10
windows::mkwindows(close;k)
.pf("windows{}";,5#windows)

:" compute the average close price for each window "
acw::mean'windows
.pf("average close windows{}";,5#acw)
