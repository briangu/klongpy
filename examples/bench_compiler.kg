:" KlongPy Expression Compiler Benchmark "
:" Measures where the compiler eliminates interpreter dispatch overhead "
:" Run:  kgpy --backend torch --device cpu examples/bench_compiler.kg "
:" Or:   kgpy --backend numpy examples/bench_compiler.kg "

.pyf("numpy.random";["random" "randn"])

N::1000

:" print a label and the milliseconds per iteration since the start time t0 "
report(label;t0)::{.pf("{}{} ms";[;label;(.pc()-t0)*1000%N])}

.p("=================================================================")
.p("KlongPy Expression Compiler Benchmark")
.p("=================================================================")

:" ---- DISPATCH OVERHEAD ---- "
:" Small arrays, many iterations: interpreter dispatch dominates "
.p("")
.p("  [dispatch overhead] 1K floats, 1000 iterations")
.p("  -------------------------------------------------")

a::random(1000)
b::random(1000)

t::.pc();N{x;a+b;x+1}:*0
report("  a+b                            ";t)

t::.pc();N{x;a*2+b;x+1}:*0
report("  a*2+b                          ";t)

t::.pc();N{x;(a*2+b)%(a+1);x+1}:*0
report("  (a*2+b)%(a+1)                  ";t)

:" ---- EXPRESSION DEPTH ---- "
:" Deeper expressions = more AST nodes = more dispatch saved "
.p("")
.p("  [expression depth] 100K floats, 1000 iterations")
.p("  -------------------------------------------------")

a::random(100000)
b::random(100000)
c::random(100000)

t::.pc();N{x;a+b;x+1}:*0
report("  a+b              (2 nodes)     ";t)

t::.pc();N{x;a*2+b;x+1}:*0
report("  a*2+b            (4 nodes)     ";t)

t::.pc();N{x;(a+b)*(a-b);x+1}:*0
report("  (a+b)*(a-b)      (6 nodes)     ";t)

t::.pc();N{x;(a*2+b)%(a+1);x+1}:*0
report("  (a*2+b)%(a+1)    (8 nodes)     ";t)

t::.pc();N{x;(a*2+b*3)%(a+1)-(b*c);x+1}:*0
report("  (a*2+b*3)%(a+1)-(b*c) (12)    ";t)

:" ---- LAMBDA EXPRESSIONS ---- "
:" Compiled lambdas match direct expressions "
.p("")
.p("  [lambda compilation] 100K floats, 1000 iterations")
.p("  -------------------------------------------------")

f::{x+y}
t::.pc();N{x;f(a;b);x+1}:*0
report("  {x+y}(a;b)       simple        ";t)

f::{x*2+y}
t::.pc();N{x;f(a;b);x+1}:*0
report("  {x*2+y}(a;b)     compound      ";t)

f::{(x+y)*(x-y)}
t::.pc();N{x;f(a;b);x+1}:*0
report("  {(x+y)*(x-y)}    complex       ";t)

f::{+/x*y}
t::.pc();N{x;f(a;b);x+1}:*0
report("  {+/x*y}(a;b)     fused reduce  ";t)

:" ---- FUSED REDUCE ---- "
:" Compiled: one function. Interpreter: multiply then reduce. "
.p("")
.p("  [fused reduce] 100K floats, 1000 iterations")
.p("  -------------------------------------------------")

t::.pc();N{x;+/a;x+1}:*0
report("  +/a              sum           ";t)

t::.pc();N{x;+/a*b;x+1}:*0
report("  +/a*b            dot product   ";t)

t::.pc();N{x;|/a-b;x+1}:*0
report("  |/a-b            max diff      ";t)

t::.pc();N{x;+/a*b+c;x+1}:*0
report("  +/a*b+c          fused 3-var   ";t)

:" ---- RUNNING OPS ---- "
:" Biggest compiler win: cummax/cummin bypass Python loops "
.p("")
.p("  [running ops] 10K floats, 1000 iterations")
.p("  -------------------------------------------------")

ts::100+randn(10000)*0.5

t::.pc();N{x;+\ts;x+1}:*0
report("  +\\ts             cumsum        ";t)

t::.pc();N{x;|\ts;x+1}:*0
report("  |\\ts             running max   ";t)

t::.pc();N{x;(|\ts)-ts;x+1}:*0
report("  (|\\ts)-ts        drawdown      ";t)

t::.pc();N{x;|/(|\ts)-ts;x+1}:*0
report("  |/(|\\ts)-ts      max drawdown  ";t)

:" ---- REAL-WORLD PATTERNS ---- "
:" Practical expressions from finance and data science "
.p("")
.p("  [real-world] 100K elements, 1000 iterations")
.p("  -------------------------------------------------")

p::50+randn(100000)*10
s::_(random(100000)*9900)+100

t::.pc();N{x;(+/p*s)%+/s;x+1}:*0
report("  (+/p*s)%+/s      vwap          ";t)

t::.pc();N{x;(a-(+/a)%#a);x+1}:*0
report("  a-(+/a)%#a       de-mean       ";t)

vwap::{(+/x*y)%+/y}
t::.pc();N{x;vwap(p;s);x+1}:*0
report("  vwap(p;s)        lambda vwap   ";t)

.p("")
.p("=================================================================")
