:"crossover: long when the fast moving average is above the slow one.

   A strategy module exposes name, signal, step and describe. meanrev.kg
   exposes the same four, and the program uses either through that interface."

:" shows: a diamond. stats is reached directly and through series; one instance"
stats::.import("../lib/stats")
series::.import("../lib/series")
book::.import("../book/portfolio")

name::"crossover"

:" shows: five names deep: cfg.strategy.params.crossover.fast"
signal(cfg;p)::{[f s up];f::cfg.strategy.params.crossover.fast;s::cfg.strategy.params.crossover.slow;
  up::series.sma(s;p)<(s-f)_series.sma(f;p);((s-1)#0),up}

step(pf;row)::{[px m q];px::*row;m::book.mark(pf;px);
  q::((row@1)*_(book.equity(m)%px))-m.pos;book.trade(m;px;q)}

describe(cfg)::{.fmt("crossover fast={} slow={}";[;$cfg.strategy.params.crossover.fast;$cfg.strategy.params.crossover.slow])}

.p("[crossover] loaded")
.export(:{;"name";name;"signal";signal;"step";step;"describe";describe})
