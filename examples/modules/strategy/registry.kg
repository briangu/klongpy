:"registry: the strategies by name, so a program can choose one at run time."

:" shows: modules are values. They are stored in a dictionary like any other value"
.l("./crossover")
.l("./meanrev")

all:::{;"crossover";crossover;"meanrev";meanrev}

pick(name)::{all@name}
names()::{["crossover" "meanrev"]}

.p("[registry] loaded")
export:::{;"choose";pick;"names";names}
