:" ============================================================"
:" Portfolio Optimization with Autograd"
:" ============================================================"
:" Demonstrates using gradient descent to find optimal portfolio"
:" weights that maximize Sharpe ratio subject to constraints."
:" Requires: pip install yfinance"
:" Run with: kgpy --backend torch portfolio_opt.kg"
:" ============================================================"

.p("Portfolio Optimization with KlongPy Autograd")
.p("==============================================")
.p("")

:" --- Fetch Real Stock Data from Yahoo Finance ---"

.pyf("stock_data";"fetchStockData")

:" Define stocks to optimize"
nassets::4

.p("Fetching stock data from Yahoo Finance (AAPL, MSFT, GOOGL, JPM)...")

:" Fetch returns for all 4 stocks"
allReturns::fetchStockData("2023-01-01";"2025-01-01")

[r0 r1 r2 r3]::allReturns
rets::[;r0;r1;r2;r3]

ndays::#r0
.pf("Loaded {} days of returns";ndays)
.p("")

:" --- Compute Statistics ---"

:" Define average function"
avg::{(+/x)%#x}

:" Annualize returns (252 trading days)"
mu::252*{avg(x)}'rets

:" Annualize volatility (multiply daily vol by sqrt(252))"
vars::{+/((x-avg(x))^2)%#x}'rets
vols::15.87*{x^0.5}'vars

.pf("Expected annual returns: {}";,mu)
.pf("Annual volatilities: {}";,vols)
.p("")

:" --- Portfolio Functions ---"

wts::[0.25 0.25 0.25 0.25]

:" Annualized variance (daily var * 252)"
annVars::252*vars

portReturn(w)::{+/w*mu}
portVar(w)::{+/((w^2)*annVars)}
portVol(w)::{(portVar(w))^0.5}
sharpe(w)::{portReturn(w)%((portVol(w))+0.0001)}

.pf("Initial weights: {}";,wts)
.pf("Initial Sharpe: {}";sharpe(wts))
.p("")

:" --- Constraint Penalties ---"

sumPenalty(w)::{100*((1-+/w)^2)}
longPenalty(w)::{100*+/((0|0-w)^2)}
loss(w)::{(0-sharpe(w))+sumPenalty(w)+longPenalty(w)}

:" --- Optimization ---"

:" Round to 2 decimal places"
round2::{(_x*100)%100}

lrp::0.01
epochs::200

.pf("Training for {} epochs with lr={}";[;$epochs;lrp])
.p("--------------------------------------------------")

:" Training step - update weights using gradient descent"
step(i)::{wts::wts-(lrp*(loss:>wts));wts::0|wts;wts::wts%(+/wts);0}

:" Progress printing function"
printProg(n)::{.d("Epoch ");.d(n);.d(": Sharpe=");.d(round2(sharpe(wts)));.pf(", weights={}";,wts)}

:" Run optimization loop (batches of 50, print progress between batches)"
batch(n)::{step'!50;printProg(n*50)}
batch'!4

.p("")
.p("Optimization complete!")
.pf("Final weights: {}";,wts)
.pf("Final Sharpe: {}";sharpe(wts))
.pf("Sum of weights: {}";+/wts)
.p("")

:" --- Analysis ---"
.p("Weight allocation:")
.pf("  AAPL: {}%";round2(100*(wts@0)))
.pf("  MSFT: {}%";round2(100*(wts@1)))
.pf("  GOOGL: {}%";round2(100*(wts@2)))
.pf("  JPM: {}%";round2(100*(wts@3)))
