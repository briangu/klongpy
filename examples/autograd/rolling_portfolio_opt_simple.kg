:" ============================================================"
:" Rolling Portfolio Optimization - Demonstrating Klong Autograd"
:" ============================================================"
:" This shows portfolio optimization using Klong's autograd (`:>`)"
:" with position constraints, all in pure Klong"
:" ============================================================"

.p("Rolling Portfolio Optimization - Klong Autograd Demo")
.p("======================================================")
.p("")

:" Simple example with hardcoded returns and volatilities"
syms::["AAPL" "MSFT" "WMT" "JPM"]
mu::[0.0013 0.0007 0.0022 0.0015]     :" Mean returns (annual)"
vols::[0.0141 0.0126 0.0111 0.0148]   :" Volatilities (annual)"

.pf("Stocks: {}";,syms)
.p("")

.d("Estimated parameters:")
.pf("Means: {}";,mu)
.pf("Vols:  {}";,vols)
.p("")

:" --- Klong functions for portfolio optimization ---"

:" Sharpe ratio: mean return / volatility, for weights w (uses global mu, vols)"
portReturn(w)::{+/w*mu}
portVol(w)::{+/((w*vols)^2)^0.5}
sharpe(w)::{portReturn(w)%(portVol(w)+0.0001)}

:" Negative Sharpe for minimization"
negSharpe(w)::{0-sharpe(w)}

:" Position constraints as penalties"
minp::0.08
maxp::0.15
minPenalty(w)::{10*+/((minp-w)|(0*w))^2}   :" Penalty for weights below min"
maxPenalty(w)::{10*+/((w-maxp)|(0*w))^2}   :" Penalty for weights above max"
sumPenalty(w)::{10*((1-+/w)^2)}            :" Penalty if weights don't sum to 1"

:" Combined loss function"
loss(w)::{negSharpe(w)+minPenalty(w)+maxPenalty(w)+sumPenalty(w)}

:" --- Optimization ---"

:" Start with equal weights"
w::[0.25 0.25 0.25 0.25]
lr::0.001
epochs::200

.pf("Initial weights: {}";,w)
.pf("Initial Sharpe:  {}";sharpe(w))
.p("")

:" Optimization step"
step(i)::{w::w-(lr*(loss:>w));w::0|w;w::w%(+/w);0}

.p("Optimizing with constraints [8%, 15%]...")
.p("Running 200 optimization steps...")

:" Run optimization"
step'!epochs

.p("")
.pf("Final weights: {}";,w)
.pf("Final Sharpe:  {}";sharpe(w))
.p("")

.p("Allocation:")
pct::100
show(i)::{.d("  ");.d(syms@i);.pf(": {}%";pct*w@i)}
show'!4

.p("")
.p("Key takeaways:")
.p("1. Autograd (:>) computes exact gradients of loss function")
.p("2. Constraints enforced via penalty functions (8-15% per stock)")
.p("3. All optimization logic is pure Klong - no Python loops!")
