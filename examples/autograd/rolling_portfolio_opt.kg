:" Rolling Portfolio Optimization - Walk-Forward Backtest"
:" Uses Klong loops and autograd - all math in Klong"

.p("Rolling Portfolio Optimization - Walk-Forward Backtest")
.p("=======================================================")
.p("")

.pyf("stock_prices";"fetchStockPrices")

syms::["AAPL" "MSFT" "WMT" "JPM"]
.p("Fetching stock data...")
prices::fetchStockPrices(syms;"2024-01-01";"2024-12-31")
.pf("Stocks: {}";,syms)

:" Compute returns from prices: (p[1:] - p[:-1]) / p[:-1]"
calcReturns(p)::{[n prev curr];n::#p;prev::(n-1)#p;curr::1_p;(curr-prev)%prev}
rets::calcReturns'prices

ndays::#(rets@0)
.pf("Days: {}";ndays)
.p("")

lookback::30
lr::0.001
optsteps::50
minp::0.08
maxp::0.15

avg::{(+/x)%#x}
stddev(v)::{[r];r::v-avg(v);((+/r^2)%#v)^0.5}

portReturn(w)::{+/w*mu}
portVol(w)::{+/((w*vols)^2)^0.5}
sharpe(w)::{portReturn(w)%(portVol(w)+0.0001)}
negSharpe(w)::{0-sharpe(w)}
minPenalty(w)::{10*+/((minp-w)|(0*w))^2}
maxPenalty(w)::{10*+/((w-maxp)|(0*w))^2}
sumPenalty(w)::{10*((1-+/w)^2)}
loss(w)::{negSharpe(w)+minPenalty(w)+maxPenalty(w)+sumPenalty(w)}

w::[0.25 0.25 0.25 0.25]
mu::[0.0 0.0 0.0 0.0]
vols::[0.01 0.01 0.01 0.01]
portReturns::[]
cumReturns::[]

optim(i)::{w::w-(lr*(loss:>w));w::0|w;w::w%(+/w);0}

:" Simple version: compute stats for a specific day outside the loop"
computeStats(day)::{[wins];wins::{(0-lookback)#x@!day}'rets;mu::avg'wins;vols::stddev'wins;0}

processDay(day)::{[dayrets];
    computeStats(day);
    optim'!optsteps;
    dayrets::{x@day}'rets;
    portReturns::portReturns,+/w*dayrets;
    cumReturns::cumReturns,+/portReturns;
    :[0=(day!50);.pf("Day {}: cumret={}";[;$day;*|cumReturns]);0];
    0
}

.p("Running walk-forward optimization...")
.pf("Lookback: {} days";lookback)
.pf("Limits: [{}%, {}%]";[;100*minp;100*maxp])
.p("")

processDay'lookback+!ndays-lookback

.p("")
.p("Complete!")
.pf("Trading days: {}";#portReturns)
.pf("Cumulative return: {}";*|cumReturns)
.p("")
.p("Final allocation:")
pct::100
show(i)::{.d("  ");.d(syms@i);.pf(": {}%";pct*w@i)}
show'!4
