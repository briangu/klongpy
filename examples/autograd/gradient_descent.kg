:" ============================================================"
:" Gradient Descent Fundamentals"
:" ============================================================"
:" Demonstrates core gradient descent concepts using autograd:"
:" 1. Finding minimum of a function"
:" 2. Rosenbrock function optimization"
:" 3. Linear regression fitting"
:" 4. Quadratic curve fitting"
:" Run with: kgpy gradient_descent.kg"
:" Or with torch: kgpy --backend torch gradient_descent.kg"
:" ============================================================"

.p("Gradient Descent with KlongPy Autograd")
.p("=======================================")
.p("")

:" ============================================================"
:" Example 1: Minimize f(t) = (t-3)^2"
:" ============================================================"

.p("Example 1: Minimize f(t) = (t-3)^2")
.p("-----------------------------------")
.p("Minimum should be at t = 3")
.p("")

f1(t)::{(t-3)^2}

t::10.0
lr1::0.1

.pf("Starting t = {}";t)
.pf("Learning rate = {}";lr1)
.p("")

print1(n;grad)::{.d("Step ");.d(n);.pf(": t={}, f(t)={}, grad={}";[;t;f1(t);grad])}
step1(n)::{[grad1];grad1::f1:>t;t::t-(lr1*grad1);:[0=(n!2);print1(n;grad1);0]}

step1'1+!10

.p("")
.pf("Final t = {} (target: 3.0)";t)
.p("")

:" ============================================================"
:" Example 2: Rosenbrock Function (challenging optimization)"
:" ============================================================"

.p("Example 2: Rosenbrock Function")
.p("-------------------------------")
.p("f(a,b) = (1-a)^2 + 100*(b-a^2)^2")
.p("Minimum at (1, 1)")
.p("")

rosenbrock(p)::{[pa pb]::p;((1-pa)^2)+100*((pb-(pa^2))^2)}

pt::[0.0 0.0]
lr2::0.001

.pf("Starting point: {}";,pt)
.pf("Learning rate: {}";lr2)
.p("")

print2(n)::{.d("Step ");.d(n);.d(": pt=");.d(pt);.pf(", f(pt)={}";rosenbrock(pt))}
step2(n)::{[grad2];grad2::rosenbrock:>pt;pt::pt-(lr2*grad2);:[0=(n!20);print2(n);0]}

step2'1+!100

.p("")
.pf("Final point: {} (target: [1, 1])";,pt)
.p("")

:" ============================================================"
:" Example 3: Fitting a Line to Data"
:" ============================================================"

.p("Example 3: Linear Regression")
.p("-----------------------------")
.p("Fit y = w*x + b to synthetic data")
.p("")

N::20
idx::!N
Xd::(4*(idx%N))-2

wTrue::2.0
bTrue::3.0
yTrue::(wTrue*Xd)+bTrue

.pf("True parameters: w={}, b={}";[;wTrue;bTrue])

w3::0.0
b3::0.0

lossW3(w)::{((+/((w*Xd)+b3-yTrue)^2))%N}
lossB3(b)::{((+/((w3*Xd)+b-yTrue)^2))%N}

lr3::0.1

.pf("Initial: w={}, b={}";[;w3;b3])
.p("")

print3(n)::{.d("Step ");.d(n);.pf(": w={}, b={}, loss={}";[;w3;b3;lossW3(w3)])}
step3(n)::{[gw3 gb3];gw3::lossW3:>w3;gb3::lossB3:>b3;w3::w3-(lr3*gw3);b3::b3-(lr3*gb3);:[0=(n!5);print3(n);0]}

step3'1+!30

.p("")
.pf("Learned: w={}, b={}";[;w3;b3])
.pf("True:    w={}, b={}";[;wTrue;bTrue])
.p("")

:" ============================================================"
:" Example 4: Quadratic Curve Fitting"
:" ============================================================"

.p("Example 4: Quadratic Curve Fitting")
.p("-----------------------------------")
.p("Fit y = a*x^2 + b*x + c to parabola")
.p("")

aTrue::0.5
bTrue2::0-2.0
cTrue::1.0
yQuad::((aTrue*(Xd^2))+(bTrue2*Xd))+cTrue

a4::0.0
b4::0.0
c4::0.0

quadPred::{((a4*(Xd^2))+(b4*Xd))+c4}
quadLoss::{(+/(quadPred()-yQuad)^2)%N}

lossA(a)::{((+/((((a*(Xd^2))+(b4*Xd))+c4)-yQuad)^2))%N}
lossB4(b)::{((+/(((a4*(Xd^2))+(b*Xd))+c4-yQuad)^2))%N}
lossC(c)::{((+/(((a4*(Xd^2))+(b4*Xd))+c-yQuad)^2))%N}

lr4::0.01

.pf("True: a={}, b={}, c={}";[;aTrue;bTrue2;cTrue])
.pf("Initial: a={}, b={}, c={}";[;a4;b4;c4])
.p("")

print4(n)::{.d("Step ");.d(n);.pf(": a={}, b={}, c={}";[;a4;b4;c4])}
step4(n)::{[ga4 gb4 gc4];ga4::lossA:>a4;gb4::lossB4:>b4;gc4::lossC:>c4;a4::a4-(lr4*ga4);b4::b4-(lr4*gb4);c4::c4-(lr4*gc4);:[0=(n!20);print4(n);0]}

step4'1+!100

.p("")
.pf("Learned: a={}, b={}, c={}";[;a4;b4;c4])
.pf("True:    a={}, b={}, c={}";[;aTrue;bTrue2;cTrue])
