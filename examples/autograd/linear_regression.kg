:" Linear Regression with Gradient Descent using KlongPy"
:" Run with: kgpy linear_regression.kg"
:" Or with torch: kgpy --backend torch linear_regression.kg"
:" Uses the :> operator which falls back to numeric gradient without torch"

.p("Linear Regression with KlongPy Autograd")
.p("==================================================")
.p("")

:" Generate synthetic data: y = 2*x + 3"
N::20
idx::!N
X::(4*(idx%N))-2

:" True parameters"
wTrue::2.0
bTrue::3.0

:" Generate y = w*x + b"
yTrue::(wTrue*X)+bTrue

.p("True parameters: w=2.0, b=3.0")

:" Initialize parameters"
w::0.0
b::0.0

.pf("Initial parameters: w={}, b={}";[;w;b])

:" The loss as a function of w (b held fixed) and of b (w held fixed), for gradient computation"
lossW(w)::{((+/((w*X)+b-yTrue)^2))%N}
lossB(b)::{((+/((w*X)+b-yTrue)^2))%N}

:" Compute initial loss"
.pf("Initial loss: {}";lossW(w))
.p("")

:" Training parameters"
lr::0.1
epochs::30

.pf("Training for {} epochs with learning_rate={}";[;$epochs;lr])
.p("--------------------------------------------------")

:" Helper to print epoch info"
printEpoch(n)::{.d("Epoch ");.d(n);.pf(": loss={}, w={}, b={}";[;lossW(w);w;b])}

:" Training step function"
step(i)::{[gw gb];gw::lossW:>w;gb::lossB:>b;w::w-(lr*gw);b::b-(lr*gb);0}

:" Run training (batches of 5, print progress between batches)"
batch(n)::{step'!5;printEpoch(n*5)}
batch'!6

.p("")
.p("Final parameters:")
.pf("  Learned: w={}, b={}";[;w;b])
.pf("  True:    w={}, b={}";[;wTrue;bTrue])
