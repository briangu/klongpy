:" See ../SOURCES.md#2024 for the upstream programs, fixture origins and answer sources for this day."
:" Reindeer Maze. Dijkstra buckets give the cost of each (tile, heading).
   Walk tight edges backwards to recover the union of tiles on optimal routes."
relax(cost;state;d;buckets)::{[old bucket];old::d@state;
    :[(:_old)|cost<:[ :_old;cost+1;old];
      {d,state,cost;bucket::buckets@cost;buckets,cost,,(:[ :_bucket;[];bucket]),state;1}();0]}
solve(lines;part;parameter)::{[w grid start end dirs d buckets cost active best ends front tiles seen];
    w::#*lines;grid::.join(lines;"");dirs::[;1;w;-1;-w];start::*grid?"S";end::*grid?"E";
    d:::{};buckets:::{};active::relax(0;4*start;d;buckets);cost::0;best::-1;
    {x;(active>0)&((best<0)|cost<best+1)}{[batch];x;batch::buckets@cost;
      :[~:_batch;
        {[state cell heading forward];state::x;active::active-1;
         :[(d@state)=cost;
          {cell::state:%4;heading::state!4;forward::cell+dirs@heading;
           :[cell=end;best::cost;
            {:[~(grid@forward)~0c#;active::active+relax(cost+1;(4*forward)+heading;d;buckets);0];
             {active::active+relax(cost+1000;(4*cell)+(heading+x)!4;d;buckets)}'[1 3]}()]}();0]}'batch;0];
      cost::cost+1}:~0;
    :[best<0;.err("range";"maze exit is unreachable"):|part=1;best;
      {ends::(4*end)+!4;front::ends@&{best~d@x}'ends;tiles:::{};seen:::{};
       {x;0<#front}{[next];x;next::[];
         {[cell dir score preds];cell::x:%4;dir::x!4;score::d@x;tiles,cell,1;
           preds::[;dir+4*cell-dirs@dir;(4*cell)+(dir+1)!4;(4*cell)+(dir+3)!4];
           {[s step];s::preds@x;step:::[x=0;1;1000];
             :[(:_seen@s)&((score-step)~d@s);{seen,s,1;next::next,s}();0]}'!3}'front;
         front::next}:~0;#tiles}()]}
export:::{;"solve";solve}
