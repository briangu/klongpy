:" See ../SOURCES.md#2024 for the upstream programs, fixture origins and answer sources for this day."
:" Claw Contraption. Solve independent buttons with Cramer's rule and minimize costs on a shared line."
.l("../parse")
pair(line)::{[fields];fields::.split(line;", ");{.num(2_(*|.words(x)))}'fields}
single(step;goal;price;part)::{[n];:[step=0;0;
    {n::goal:%step;:[(0=goal!step)&((part=2)|n<101);price*n;0]}()]}
parallel(a;b;t;part)::{[r s k l inc dec low high best];
    :[a=0;single(b;t;1;part):|b=0;single(a;t;3;part);
      {r::a;s::b;{x;s>0}{[rem];x;rem::r!s;r::s;s::rem}:~0;
       inc::b:%r;dec::a:%r;k::0;
       {x;(k<inc)&~0=(t-a*k)!b}{x;k::k+1}:~0;
       l::(t-a*k):%b;
       :[(k=inc)|(l<0)|((part=1)&k>100);0;
         {low::0;high::l:%dec;
          :[part=1;{high::high&(100-k):%inc;:[l>100;low::((l-101)+dec):%dec;0]}();0];
          best:::[(3*inc)<dec;high;low];
          :[low>high;0;(3*k)+l+best*((3*inc)-dec)]}()]}()]}
tokens(block;part)::{[a b goal det an bn axis];[a b goal]::pair'block;
    :[part=2;goal::goal+10000000000000;0];det::((a@0)*b@1)-(b@0)*a@1;
    an::((goal@0)*b@1)-(b@0)*goal@1;bn::((a@0)*goal@1)-(goal@0)*a@1;
    :[det=0;:[(an=0)&bn=0;
      {axis:::[(a@0)|b@0;0;1];parallel(a@axis;b@axis;goal@axis;part)}();0]:|(0=an!det)&0=bn!det;
      {an::an:%det;bn::bn:%det;:[(an>(-1))&(bn>(-1))&((part=2)|100>(an|bn)-1);(3*an)+bn;0]}();0]}
solve(lines;part;parameter)::{+/tokens(;part)'parse.blocks(lines)}
export:::{;"solve";solve}
