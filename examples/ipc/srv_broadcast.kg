:"broadcast a hello message to all connected clients"

clients:::{}

send(client)::{client(".p(""hello from server"")")}
broadcast::{.p("sending messages to clients");{send(x@0)}'clients}
cb::{:[(#clients)>0;broadcast();.p("no clients connected")]}
th::.timer("greeting";1;cb)

.srv(8888)
.srv.o(client)::{.pf("adding client: {}";client);clients,client,1}
.srv.c(client)::{.pf("removing client: {}";client);client _ clients;.pf("clients left: {}";#clients)}
.srv.e(client;message)::{.pf("error: {}";client);.p(message)}
